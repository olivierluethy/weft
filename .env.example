# ─────────────────────────────────────────────────────────────
# Weft environment. Copy to `.env` (root) — read by @weft/server.
# Everything here has a working default; you can boot with zero edits.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Public URL of the web app, used in emails (reset/invite links).
WEB_ORIGIN=http://localhost:5173
# Comma-separated allowed CORS origins (defaults to WEB_ORIGIN).
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite by default (single file, zero-config). Swap to Postgres by changing
# this URL to postgresql://... and the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Auth / JWT ---
# CHANGE THESE for anything beyond local dev. Any non-empty strings work locally.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Access token lifetime (short). Refresh lifetimes below.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# "Stay logged in" refresh lifetime (long-lived).
REFRESH_TOKEN_TTL_DAYS_REMEMBER=90
# Set to true to send cookies only over HTTPS (leave false for local http).
COOKIE_SECURE=false

# --- Email (password reset & invites) ---
# Leave SMTP_HOST empty to use the dev fallback: reset/invite links are printed
# to the server console AND appended to apps/server/data/outbox/outbox.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Weft <no-reply@weft.local>"

# --- Uploads ---
# Local disk directory (served statically at /uploads). Max upload size in MB.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Collaboration (Hocuspocus / Yjs) ---
# The realtime server is mounted on the same Fastify process under this path.
COLLAB_PATH=/collab

# --- External services (all keyless, all optional & gracefully degraded) ---
# Image search proxy targets:
OPENVERSE_API=https://api.openverse.org/v1
WIKIMEDIA_API=https://commons.wikimedia.org/w/api.php
# IP geolocation for the login/session log:
GEO_API=http://ip-api.com/json
